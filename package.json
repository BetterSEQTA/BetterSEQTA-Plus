{
  "name": "betterseqtaplus",
  "version": "3.7.7",
  "description": "Enhance SEQTA Learn's usability and aesthetics! A fork of BetterSEQTA to continue development and add heaps more features!",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "SethBurkart123",
    "email": "betterseqta.plus@gmail.com",
    "url": "https://github.com/BetterSEQTA/BetterSEQTA-Plus"
  },
  "type": "module",
  "scripts": {
    "compile:layerchart": "node scripts/compile-layerchart-vendor.mjs",
    "postinstall": "node scripts/copy-runtime-assets.mjs && npm run compile:layerchart",
    "autoaudit": "npm audit && npm audit fix && npm run build",
    "dev": "cross-env MODE=chrome vite dev",
    "dev:firefox": "cross-env MODE=firefox vite build --watch",
    "compile": "npm i && npm run build",
    "build": "npm run compile:layerchart && cross-env MODE=chrome vite build && cross-env MODE=firefox vite build",
    "build:chrome": "cross-env MODE=chrome vite build",
    "build:firefox": "cross-env MODE=firefox vite build",
    "build:safari": "cross-env MODE=safari vite build",
    "build:dev": "cross-env MODE=chrome SOURCEMAP=true vite build && cross-env MODE=firefox SOURCEMAP=true vite build",
    "convert:safari": "xcrun safari-web-extension-converter dist/safari --project-location . --app-name $npm_package_name-safari",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "npm run test:unit",
    "test:unit": "cross-env NODE_OPTIONS=--no-experimental-webstorage jest",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:ci": "npm run test:unit && npm run build && npm run test:smoke",
    "release": "gh release create $npm_package_version --repo BetterSEQTA/BetterSEQTA-Plus ./dist/*.zip --generate-notes",
    "publish": "node lib/publish.js --b",
    "zip": "node scripts/package-extension-zips.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@huggingface/transformers": "^3.8.1",
    "@lucide/svelte": "^1.66.0",
    "@uiw/codemirror-extensions-color": "^4.25.12",
    "@uiw/codemirror-theme-github": "^4.25.12",
    "canvas-confetti": "^1.9.4",
    "color": "^5.0.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "dompurify": "^3.4.17",
    "embeddia": "^1.3.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-svelte": "^8.6.0",
    "fuse.js": "^7.5.0",
    "layerchart": "^2.9.2",
    "localforage": "^1.10.0",
    "lucide-static": "^1.66.0",
    "mathjs": "^15.2.0",
    "motion": "^14.9.0",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "semver": "^7.7.1",
    "sortablejs": "^1.15.7",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@jest/globals": "^30.5.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/canvas-confetti": "^1.9.0",
    "@types/chrome": "^0.3.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/jest": "^30.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/semver": "^7.8.0",
    "@types/sortablejs": "^1.15.9",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "mime-types": "^3.0.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "publish-browser-extension": "^6.2.0",
    "sass": "^1.107.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "overrides": {
    "glob": "^14.0.3"
  },
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild": false,
    "onnxruntime-node": false,
    "protobufjs": false,
    "sharp": false
  }
}
